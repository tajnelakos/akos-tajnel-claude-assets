  "libraries": [],
  "components": [
    {
      "name": "EventInvite",
      "group": "Carousels",
      "summary": "An invitation to meet the team or hear a talk: a centred question, the talk, the speaker, then date, place and one button."
    },
    {
      "name": "FeatureLaunch",
      "group": "Carousels",
      "summary": "Launches a capability: a \"New in …\" cover, the problem it solves, one or two screenshots on paper, and a close."
    },
    {
      "name": "FieldGuide",
      "group": "Carousels",
      "summary": "A numbered list: a count-led cover, one slide per check, step or question, a checklist summary on paper, and a close."
    },
    {
      "name": "MythVsMethod",
      "group": "Carousels",
      "summary": "Corrects a belief the market repeats: the belief in an outlined card, why it fails under scrutiny, and what a defensible method looks like."
    },
    {
      "name": "ProofInNumbers",
      "group": "Carousels",
      "summary": "One result told honestly: the figure, what it measures, a chart against its baseline, the method and its limits."
    },
    {
      "name": "RegulationBrief",
      "group": "Carousels",
      "summary": "What a rule means for banks and lenders: what it asks, what to prepare, and where Seekridge fits."
    },
    {
      "name": "MomentExplainer",
      "group": "Carousels",
      "summary": "Shows how one moment is built: three data layers, the evidence trail with its weights, and what the advisor does with it."
    },
    {
      "name": "SlideKit",
      "group": "Carousels",
      "summary": "The reusable slide archetypes behind every format, grouped by job, for building a new carousel by mixing them."
    }
  ],
