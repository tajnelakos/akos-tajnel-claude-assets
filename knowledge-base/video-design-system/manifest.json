      "preview": "components/AuditLog/preview.html"
    },
    {
      "name": "LayerStack",
      "group": "Data",
      "summary": "The three data layers for one customer, drawn as three bands whose connectors meet in one moment.",
      "readme": "components/LayerStack/README.md",
      "preview": "components/LayerStack/preview.html"
    },
    {
      "name": "FigureCard",
      "group": "Data",
      "summary": "One number, counting up on Navy, with what it measures and where it came from.",
      "readme": "components/FigureCard/README.md",
      "preview": "components/FigureCard/preview.html"
    },
    {
      "name": "BacktestChart",
      "group": "Data",
      "summary": "How past moments performed on the client's own book: ten deciles in navy, the top decile in gold, the book average dashed.",
      "readme": "components/BacktestChart/README.md",
      "preview": "components/BacktestChart/preview.html"
    },
    {
      "name": "RidgeField",
      "group": "Data",
      "summary": "The customer base as a moving dot map: always in motion, only the week's moments rise into peaks, one in gold.",
      "readme": "components/RidgeField/README.md",
      "preview": "components/RidgeField/preview.html"
    },
    {
      "name": "Timeline",
      "group": "Data",
      "summary": "A straight track with dated events: solid for what has happened, dashed for what is expected.",
      "readme": "components/Timeline/README.md",
      "preview": "components/Timeline/preview.html"
    },
    {
      "name": "SegmentTriptych",
      "group": "Data",
      "summary": "Three segments side by side, each a moment with its top evidence: the same grammar for banks, insurers and brokerages.",
