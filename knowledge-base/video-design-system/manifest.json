      "preview": "components/MomentCard/preview.html"
    },
    {
      "name": "EvidenceTrail",
      "group": "Product UI",
      "summary": "The signature component: every data point behind a moment, with its layer, value and weight, the top weight in gold.",
      "readme": "components/EvidenceTrail/README.md",
      "preview": "components/EvidenceTrail/preview.html"
    },
    {
      "name": "FocusMarks",
      "group": "Product UI",
      "summary": "Four corner brackets that close on the element a beat is about, while the rest of the panel dims.",
      "readme": "components/FocusMarks/README.md",
      "preview": "components/FocusMarks/preview.html"
    },
    {
      "name": "AuditLog",
      "group": "Product UI",
      "summary": "The record of what happened to a moment: timestamped mono lines that type in, one per event.",
