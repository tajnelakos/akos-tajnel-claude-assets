      "preview": "components/ChapterRail/preview.html"
    },
    {
      "name": "ProductPanel",
      "group": "Product UI",
      "summary": "A flat white panel rebuilt from a Seekridge screen: hairline frame that traces in, sunken header, 72px rows.",
      "readme": "components/ProductPanel/README.md",
      "preview": "components/ProductPanel/preview.html"
    },
    {
      "name": "MomentCard",
      "group": "Product UI",
      "summary": "One moment for one customer: moment name, customer ID, rank this week, and its top two evidence rows.",
